# .env.example
# Copy this to .env and fill in your real values.
# NEVER commit .env itself.

# Groq API
GROQ_API_KEY=gsk_your_key_here

# Database (Docker default — change for production)
DATABASE_URL=postgresql://aura:aura_dev_pass@localhost:5432/aura_db

# App settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Models
# openai/gpt-oss-120b and openai/gpt-oss-20b are Groq-hosted open-weight models
# (added to Groq's catalog after the original plan was written). llama-3.3-70b-versatile
# and llama-3.1-8b-instant also work if you prefer Meta's models instead.
LLM_CONVERSATION_MODEL=openai/gpt-oss-120b
LLM_ANALYSIS_MODEL=openai/gpt-oss-20b

# Whisper
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
