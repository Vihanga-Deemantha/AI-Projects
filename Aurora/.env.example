# .env.example
# Copy this to .env and fill in your real values.
# NEVER commit .env itself.

# Groq API
GROQ_API_KEY=gsk_your_key_here

# Database (Docker default — change for production)
DATABASE_URL=postgresql://aura:aura_dev_pass@localhost:5432/aura_db

# App settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Models
# openai/gpt-oss-120b and openai/gpt-oss-20b are Groq-hosted open-weight models
# (added to Groq's catalog after the original plan was written). llama-3.3-70b-versatile
# and llama-3.1-8b-instant also work if you prefer Meta's models instead.
LLM_CONVERSATION_MODEL=openai/gpt-oss-120b
LLM_ANALYSIS_MODEL=openai/gpt-oss-20b

# Whisper
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_me_with_a_random_secret
JWT_EXPIRE_MINUTES=10080

# Google OAuth (Phase 3c) — console.cloud.google.com. Leave blank to disable
# Google sign-in; everything else keeps working without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Email / OTP (Phase 3c) — resend.com. Leave blank to disable forgot-password.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Avatar storage (Phase 3c) — console.cloudinary.com → Dashboard. Leave blank
# to disable avatar upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL — where the browser gets redirected back to after Google OAuth
FRONTEND_URL=http://localhost:3000
