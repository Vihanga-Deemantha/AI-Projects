# .env.example
# Copy this to .env and fill in your real values.
# NEVER commit .env itself.

# ── Required ────────────────────────────────────────────────────────────────

# Groq API (LLM, and optionally speech-to-text) — console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Database (Docker default — change for production)
DATABASE_URL=postgresql://aura:aura_dev_pass@localhost:5432/aura_db

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this logs everyone out.
JWT_SECRET=replace_me_with_a_random_secret
JWT_EXPIRE_MINUTES=10080

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # "development" or "production"
LOG_LEVEL=INFO
SQL_ECHO=false                   # true logs every SQL statement (noisy; includes emails/transcripts)

# Where the frontend lives. Used for the Google sign-in redirect and always
# allowed by CORS.
FRONTEND_URL=http://localhost:3000
# Extra browser origins allowed to call the API (comma-separated). In
# development localhost:3000 / 127.0.0.1:3000 / :5173 are allowed automatically.
CORS_ORIGINS=

# ── LLM ─────────────────────────────────────────────────────────────────────
# openai/gpt-oss-120b and openai/gpt-oss-20b are Groq-hosted open-weight models.
# llama-3.3-70b-versatile and llama-3.1-8b-instant also work (set
# LLM_REASONING_EFFORT= to empty for non-reasoning models).
LLM_CONVERSATION_MODEL=openai/gpt-oss-120b
# The model that finds your grammar/vocabulary mistakes. 120b is recommended: on the
# regression suite it passed all 23 cases it was tuned on where 20b passed 20 (and once
# flagged correct English as a mistake — the worst failure for a learner). Both share
# Groq rate limits: the free tier allows only ~8,000 tokens/minute and 200,000 tokens/day
# per model, which three learners practising at once can use up in a minute and a day of
# heavy testing can use up entirely (the coach then says it is busy). A paid Groq tier, or
# a different model for each of these two settings (each model has its own budget),
# gives more headroom.
LLM_ANALYSIS_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_CONTEXT_MESSAGES=20          # how many recent messages the coach sees each turn
# The background analysis waits out a rate limit this many times (a live reply never does).
LLM_ANALYSIS_RETRIES=5

# ── Speech-to-text ──────────────────────────────────────────────────────────
# local: faster-whisper on this machine (private/offline, but base.en drops
#        "um/uh", sometimes silently corrects a learner's grammar, and slows
#        down a lot with several simultaneous users).
# groq:  Groq-hosted Whisper — more accurate on accented speech, keeps filler
#        words and learner errors verbatim, no local CPU load. The audio is sent
#        to Groq. RECOMMENDED if you're happy with that.
STT_PROVIDER=local
GROQ_STT_MODEL=whisper-large-v3-turbo
WHISPER_MODEL_SIZE=base.en       # local provider only
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Per-turn limits for the voice endpoint
MAX_AUDIO_BYTES=5242880          # 5 MB
MAX_AUDIO_SECONDS=120

# ── Security / startup ──────────────────────────────────────────────────────
RATE_LIMITS_ENABLED=true         # in-memory limits on login/signup/OTP/uploads/voice turns
BCRYPT_ROUNDS=12                 # password hash cost (the tests use 4)
PREWARM_MODELS=true              # load Whisper + the six companion voices at boot so the first reply isn't slow (the two accent voices load when a session first needs them)
CHECK_MIGRATIONS_ON_STARTUP=true # warn (dev) / refuse to start (production) if the DB is behind

# ── Optional features (leave blank to disable) ──────────────────────────────

# Google sign-in — console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Email codes (password reset, email verification) — resend.com
# Without it, in development the codes are printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Profile photo storage — console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Error tracking with Sentry (optional). It reports where and what broke, and is configured
# to send no personal data, request bodies or local variables (see backend/observability.py).
SENTRY_DSN=

# ── Tests only ──────────────────────────────────────────────────────────────
# The test suite NEVER uses DATABASE_URL. It needs its own database (the name
# must end in _test) and creates it on demand.
# TEST_DATABASE_URL=postgresql://aura:aura_dev_pass@localhost:5432/aura_test
