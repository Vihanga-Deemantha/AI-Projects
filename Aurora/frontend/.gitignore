# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.nyc_output

# next.js
/.next/
/out/
/.swc
.turbo

# production
/build
/dist

# misc
.DS_Store
*.pem
*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values, but DO commit the example so the
# required variables stay documented for anyone cloning the repo.
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OS / OneDrive artifacts (this project lives inside a OneDrive folder)
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# editor
.vscode/
.idea/
*.swp
*.swo
*~

# logs
*.log
logs/
